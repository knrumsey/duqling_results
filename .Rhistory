library(quack)
?quack::mvn_mix()
library(duqling)
?duqling::gamma_mix
library(coactivity)
f1 <- function(xx) duqling::borehole(xx, adjust_fidelity = 1)
f0 <- duqling::borehole
X <- lhs::randomLHS(1000, 10)
y0 <- apply(X, 1, f0)
y1 <- apply(X, 1, f1)
fit0 <- bass(X, y0)
library(bass)
library(BASS)
fit0 <- bass(X, y0)
fit1 <- bass(X, y1)
coactivity::concordance(fit0, fit1)
tmp <- expand.grid(1:25, 1:25)
coactivity::concordance(fit0, fit1, mcmc.use=tmp)
class(tmp)
tmp <- as.matrix(expand.grid(1:25, 1:25))
class(tmp)
coactivity::concordance(fit0, fit1, mcmc.use=tmp)
conc <- coactivity::concordance(fit0, fit1)
tmp <- as.matrix(expand.grid(1:10, 1:10))
conc <- coactivity::concordance(fit0, fit1, mcmc.use = tmp)
length(fit0$s2)
fit0
