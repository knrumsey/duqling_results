res[i] <- run_simulation(n)
if(i %% 1000 == 0) print(i)
}
table(res) / NSIMS
plot(table(res) / NSIMS)
plot(0:10, table(res) / NSIMS)
plot(1:10, table(res) / NSIMS)
plot(1:10, table(res) / NSIMS, type="o")
