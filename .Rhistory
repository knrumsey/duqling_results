roll <- sample(c("L", "R", "C", "X"), 1, prob = c(1,1,1,3))
if(roll == "L"){
j <- 1 + (i - 2) %% n
chips[i] <- chips[i] - 1
chips[j] <- chips[j] + 1
}
if(roll == "R"){
j <- 1 + i %% n
chips[i] <- chips[i] - 1
chips[j] <- chips[j] + 1
}
if(roll == "C"){
chips[i] <- chips[i] - 1
}
}
}
}
winner <- which.max(chips)
chips
n <- 10
chips <- rep(3, n)
win_condition <- function(chips) sum(chips > 0) == 1
cnt <- 0
while(!win_condition(chips)){
cnt <- cnt + 1
for(i in 1:n){
if(win_condition(chips)) break
if(chips[i] > 0){
roll <- sample(c("L", "R", "C", "X"), 1, prob = c(1,1,1,3))
if(roll == "L"){
j <- 1 + (i - 2) %% n
chips[i] <- chips[i] - 1
chips[j] <- chips[j] + 1
}
if(roll == "R"){
j <- 1 + i %% n
chips[i] <- chips[i] - 1
chips[j] <- chips[j] + 1
}
if(roll == "C"){
chips[i] <- chips[i] - 1
}
}
}
}
