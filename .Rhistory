chips[j] <- chips[j] + 1
}
if(roll == "R"){
j <- 1 + i %% n
chips[i] <- chips[i] - 1
chips[j] <- chips[j] + 1
}
if(roll == "C"){
chips[i] <- chips[i] - 1
}
}
}
}
winner <- which.max(chips)
